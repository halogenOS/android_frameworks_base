package {
    default_applicable_licenses: ["frameworks_base_license"],
}

java_library_static {
    name: "services.charging",
    defaults: ["platform_service_defaults"],
    srcs: ["java/**/*.kt"],
    libs: ["services.core"],
    static_libs: [
        "custom.hardware.health.charging-V2-java",
        "custom.health.charging",
    ],
    jarjar_rules: "jarjar-rules.txt",
}
