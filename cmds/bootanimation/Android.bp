package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "frameworks_base_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["frameworks_base_license"],
}

cc_library_static {
    name: "libbootanimation_surface",
    srcs: ["surface/boot_surface.cpp"],
    shared_libs: [
        "libbase",
        "libbinder",
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
    export_include_dirs: ["surface"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
    ],
}

rust_bindgen {
    name: "libboot_surface_bindgen",
    crate_name: "boot_surface_bindgen",
    wrapper_src: "surface/boot_surface.h",
    source_stem: "bindings",
    bindgen_flags: [
        "--allowlist-function=boot_surface_.*",
    ],
}

rust_binary {
    name: "bootanimation",
    crate_name: "bootanimation",
    crate_root: "src/main.rs",
    srcs: [
        "src/**/*.rs",
        "src/shaders/*.glsl",
    ],
    edition: "2021",
    flags: [
        "-Dclippy::expect_used",
        "-Dclippy::indexing_slicing",
        "-Dclippy::let_underscore_must_use",
        "-Dclippy::panic",
        "-Dclippy::pedantic",
        "-Dclippy::todo",
        "-Dclippy::unimplemented",
        "-Dclippy::unreachable",
        "-Dclippy::unwrap_used",
        "-Dunused_results",
    ],
    rustlibs: [
        "libboot_surface_bindgen",
        "libgl",
        "libkhronos_egl",
        "liblibc",
        "liblibloading",
        "liblog_rust",
        "liblogger",
        "libnum_traits",
        "librustutils",
        "libskrifa",
    ],
    static_libs: ["libbootanimation_surface"],
    // A Rust binary links the shared libraries needed by the C++ static libraries in static_libs
    // itself.
    shared_libs: [
        "libbase",
        "libbinder",
        "libc++",
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
    required: ["Roboto-Regular.ttf"],
    init_rc: ["bootanim.rc"],
}
