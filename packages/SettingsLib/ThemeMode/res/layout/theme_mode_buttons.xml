<com.google.android.material.button.MaterialButtonToggleGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/theme_mode_buttons"
    style="@style/Widget.Material3.MaterialButtonToggleGroup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:spacing="2dp"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight"
    app:innerCornerSize="4dp"
    app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/theme_mode_light"
        style="@style/ThemeModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode_light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/theme_mode_dark"
        style="@style/ThemeModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode_dark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/theme_mode_dim"
        style="@style/ThemeModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode_dim" />
</com.google.android.material.button.MaterialButtonToggleGroup>
