package {
    default_applicable_licenses: ["frameworks_base_license"],
}

// Light, Dark and Dim: reads and applies the theme mode, and the toggle group that sets it.
android_library {
    name: "SettingsLibThemeMode",
    use_resource_processor: true,

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    static_libs: [
        "androidx.annotation_annotation",
        "com.google.android.material_material",
        "kotlinx_coroutines",
    ],

    visibility: [
        "//packages/apps/Settings:__subpackages__",
        "//packages/apps/ThemePicker:__subpackages__",
        "//packages/apps/WallpaperPicker2:__subpackages__",
    ],
}
