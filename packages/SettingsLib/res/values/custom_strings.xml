<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Name of the setting that picks the audio quality of the codec in use on a Bluetooth headset, on the Quick Settings tile and on the device page [CHAR LIMIT=30] -->
    <string name="bluetooth_audio_quality_title">Audio quality</string>
    <!-- Codec of a Bluetooth headset and the quality level it runs at, such as "LDAC · Balanced" [CHAR LIMIT=40] -->
    <string name="bluetooth_audio_quality_codec_and_level"><xliff:g id="codec" example="LDAC">%1$s</xliff:g> · <xliff:g id="level" example="Balanced">%2$s</xliff:g></string>
    <!-- Quality of a Bluetooth headset whose codec runs at a quality that cannot change, such as "Fixed for aptX" [CHAR LIMIT=24] -->
    <string name="bluetooth_audio_quality_fixed">Fixed for <xliff:g id="codec" example="aptX">%1$s</xliff:g></string>
    <!-- Quality level of a Bluetooth audio codec with the bitrate it runs at, in a list of levels [CHAR LIMIT=40] -->
    <string name="bluetooth_audio_quality_level_with_bitrate"><xliff:g id="level" example="Balanced">%1$s</xliff:g> (<xliff:g id="bitrate" example="660 kbps">%2$s</xliff:g>)</string>
    <!-- Bitrate of a Bluetooth audio quality level in kilobits per second [CHAR LIMIT=12] -->
    <string name="bluetooth_audio_quality_kbps"><xliff:g id="kbps" example="660">%1$d</xliff:g> kbps</string>
    <!-- Bitrate of a Bluetooth audio quality level whose encoder follows the strength of the radio link [CHAR LIMIT=12] -->
    <string name="bluetooth_audio_quality_adaptive">adaptive</string>

    <!-- Name of the hardware offload row on a Bluetooth device page [CHAR LIMIT=NONE] -->
    <string name="bluetooth_a2dp_hw_offload_title">Bluetooth A2DP hardware offload</string>
    <!-- Warning in the hardware offload dialog: hardware encoding can reduce audio quality [CHAR LIMIT=NONE] -->
    <string name="bluetooth_a2dp_hw_offload_warning">Using hardware offload for Bluetooth audio can make the result sound worse. Using software encoding guarantees consistent quality regardless of hardware.</string>
    <!-- Summary of the hardware offload row when every codec uses software encoding
         [CHAR LIMIT=40] -->
    <string name="bluetooth_a2dp_hw_offload_none">All codecs use software encoding</string>
    <!-- Label under the codec that streams to the connected headset [CHAR LIMIT=12] -->
    <string name="bluetooth_a2dp_hw_offload_in_use">In use</string>
    <!-- Footer in the hardware offload dialog: the choice covers every headset [CHAR LIMIT=50] -->
    <string name="bluetooth_a2dp_hw_offload_all_headsets">Applies to all headsets.</string>

    <!-- Deep sleep info -->
    <string name="status_deep_sleep">(Deep sleep: %1$d%2$s)</string>
</resources>
